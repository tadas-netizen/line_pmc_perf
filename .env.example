# Copy to .env and `set -a; . ./.env; set +a` before running from a shell. Never commit .env.
# tools/runner.py reads .env, then .env.<target> (local / stg / prod) for the selected target.

# Target: chosen PER RUN, not here. There is NO default — scripts refuse to start without one.
#   mock:  scripts/dry-run.sh / tools/runner.py "local (mock)"      — sets PERF_BASE to the mock
#   local: PERF_TARGET=local k6 run …                                — http://localhost:3000 (pnpm dev + emulators)
#   stg:   PERF_TARGET=stg  PERF_CONFIRM=STAGING     k6 run …        — host from PERF_STG_BASE (.env.stg)
#   prod:  PERF_TARGET=prod PERF_CONFIRM=PRODUCTION  k6 run …        — host from PERF_PROD_BASE (.env.prod)
# NEVER put PERF_TARGET or PERF_CONFIRM in this file: the confirmation word must be typed for each
# run (human-error guard in lib/config.js; the runner ignores both keys in .env files).
# The real stg / prod domains are not stored in the repo either — put them in .env.stg / .env.prod:
# PERF_STG_BASE=https://…
# PERF_PROD_BASE=https://…

# Accounts (docs/api-spec-loadtest.md §1.2 / §2). On local targets the emulator seed's accounts are
# the defaults (`pnpm seed:users`); stg / prod need their own in .env.<target>.
# SUPER_ADMIN — users / partners / referral codes / QR upload; the default admin session
PERF_ADMIN_USER=admin
PERF_ADMIN_PASS=admin123
# PARTNER_ADMIN — scoped (sees / writes its own partners only); PERF_ADMIN_ROLE=partner makes it the admin session
PERF_PARTNER_USER=partneradmin
PERF_PARTNER_PASS=partner-pass-1
# PARTNER_VIEWER — 403 on every write (smoke's negative checks)
PERF_VIEWER_USER=partnerviewer
PERF_VIEWER_PASS=viewer-pass-1
# An inactive account for smoke's "login → 401" check (optional)
# PERF_INACTIVE_USER=inactiveuser
# PERF_INACTIVE_PASS=inactive-pass-1

# Which session the admin endpoints / journeys use: super (every partner) or partner (scoped)
PERF_ADMIN_ROLE=super
# Partner codes: PERF_PARTNERS limits the storefront spread (empty = every partner with an orderable
# product in GET /api/products); PERF_PARTNER = the one code used where one is needed (admin
# products list, discount codes, the scoped `?partner=`; empty = the first orderable)
# PERF_PARTNERS=P01,P02,P03
# PERF_PARTNER=6TY

# Files: the slip POST /api/orders uploads (relative to lib/) and the GCS file id GET /api/admin/slip reads
PERF_SLIP_FILE=../fixtures/slip.png
PERF_SLIP_FILE_ID=perf-slip-seed.png
# Optional: a file id for GET /api/product-image/{id}?folder=qr-code-payment (products.image is skipped without it)
# PERF_IMAGE_FILE_ID=qr-1700000000-abcd1234.png
# Discount codes the storefront validates
PERF_REFERRAL_CODE=1234
PERF_PROMOTION_CODE=WELCOME10

# Gate (lib/thresholds.js GATE): p95 ms, error rate, "slower than this is an error" ms
# PERF_GATE_P95=300
# PERF_GATE_ERR=0.01
# PERF_GATE_SLOW_MS=1000

# Run identity
PERF_RUN_ID=local
PERF_ROUND=1

# Optional overrides
# PERF_VUS=5
# PERF_HOLD=5m          # steady hold measured (ramp 30s up / 30s down around it)
# PERF_RAMP=30s
# PERF_RAMP_DOWN=30s

# scripts/local-prepare.sh: where the pmc-line checkout is (its seeds run from there)
# PMC_LINE_DIR=../pmc-line
